# ============================================================================
# TrekMate AI - Environment Configuration
# ============================================================================

# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database Configuration
# For local development (SQLite):
# DATABASE_URL=sqlite:///./instances/tma.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/trekmate_db

# Redis Configuration (optional - for caching)
# REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=SimpleCache

# ============================================================================
# AI/LLM Configuration
# ============================================================================

# LLM Provider Selection
# Options: "openai", "anthropic", "gemini", "mock"
# Use "mock" for offline development/testing (rule-based responses)
LLM_PROVIDER=mock

# OpenAI Configuration
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) Configuration
# Get API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration
# Get API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ============================================================================
# Embeddings Configuration
# ============================================================================

# Embeddings Provider
# Options: "openai", "huggingface", "mock"
# Use "mock" for offline development (random embeddings)
EMBEDDING_PROVIDER=mock

# OpenAI Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# HuggingFace Embeddings (local, no API key needed)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# RAG Configuration
# ============================================================================

# Document Chunking Settings
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120

# Vector Search Settings
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.05

# ============================================================================
# Admin Credentials (Default Seed)
# ============================================================================

ADMIN_EMAIL=admin@tma.com
ADMIN_PASSWORD=Admin@123

# ============================================================================
# Deployment Configuration
# ============================================================================

# Server Port
PORT=5000

# CORS Origins (comma-separated for production)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# Email Configuration (Celery Tasks)
# ============================================================================

# For local development with MailHog:
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=

# For production (Gmail example):
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# ============================================================================
# Celery Configuration (Background Jobs)
# ============================================================================

# Celery Broker
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================================
# AI Provider Cost Estimation (For Reference)
# ============================================================================

# OpenAI Pricing (as of 2024):
# - GPT-4o-mini: $0.150 / 1M input tokens, $0.600 / 1M output tokens
# - text-embedding-3-small: $0.020 / 1M tokens

# Anthropic Pricing:
# - Claude 3.5 Sonnet: $3.00 / 1M input tokens, $15.00 / 1M output tokens

# Google Gemini Pricing:
# - Gemini 1.5 Flash: Free tier available, then $0.075 / 1M input tokens

# ============================================================================
# Development Notes
# ============================================================================

# 1. NEVER commit this file with real API keys to version control
# 2. Use "mock" provider for local development without API costs
# 3. For production, use environment variables instead of .env file
# 4. Vector store (FAISS) is stored locally in backend/instances/faiss_index/
# 5. Uploaded documents are stored in backend/instances/documents/

# ============================================================================
# Quick Start Guide
# ============================================================================

# 1. Copy this file to .env:
#    cp .env.example .env

# 2. For offline development (no API keys needed):
#    Set LLM_PROVIDER=mock and EMBEDDING_PROVIDER=mock

# 3. For full AI features with OpenAI:
#    - Get API key from https://platform.openai.com/api-keys
#    - Set LLM_PROVIDER=openai
#    - Set OPENAI_API_KEY=your-key-here
#    - Set EMBEDDING_PROVIDER=openai

# 4. Install dependencies:
#    pip install -r requirements.txt

# 5. Seed sample data:
#    python seeds.py

# 6. Run the application:
#    python app.py
