# TMA Backend Environment Configuration

# Flask / JWT Security
SECRET_KEY=change-this-secret-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production

# Database Configuration:
# For local SQLite (leave DATABASE_URL empty or comment it out):
# SQLALCHEMY_DATABASE_URI will automatically default to sqlite:///instances/tma.db
#
# For Render / Supabase / Neon / PostgreSQL:
DATABASE_URL=postgresql://tma_user:your_password@dpg-xxxx.render.com/tmadb

# Cache Configuration (SimpleCache for memory, or RedisCache if Redis URL provided)
CACHE_TYPE=SimpleCache
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Default Admin Credentials (seeded on initial DB creation)
ADMIN_EMAIL=admin@tma.com
ADMIN_PASSWORD=Admin@123

# Email Notifications (Optional in production: configure SendGrid / Gmail / Resend / Mailtrap SMTP)
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@yourdomain.com

# Optional Webhook Notifications
GOOGLE_CHAT_WEBHOOK_URL=
