# Vercel Frontend Environment Variables
# In local development: leave empty to use Vite local proxy (/api -> http://localhost:5000)
# In production on Vercel: set to your deployed Render backend URL (with or without /api)
# Example: https://tma-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api
